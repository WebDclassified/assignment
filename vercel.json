{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "dist/server.bundle.cjs",
      "buildCommand": "pnpm --filter @pathlens/contracts build && pnpm --filter @pathlens/api build && pnpm --filter @pathlens/api bundle"
    },
    "dashboard": {
      "root": "apps/dashboard",
      "framework": "vite",
      "buildCommand": "pnpm --filter @pathlens/contracts build && pnpm build"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "dashboard" } }
  ]
}

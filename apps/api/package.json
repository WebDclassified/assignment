{
  "name": "@pathlens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "bundle": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.bundle.cjs --external:kerberos --external:@mongodb-js/zstd --external:snappy --external:aws4 --external:@aws-sdk/credential-providers --external:gcp-metadata --external:socks --log-level=warning",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@pathlens/contracts": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "mongodb": "^6.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.0"
  }
}

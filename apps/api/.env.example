[TEMPLATE]
# Required. Production MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DB_NAME
# Optional — defaults shown.
MONGODB_DATABASE=pathlens
ALLOWED_ORIGINS=https://your-production-domain
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
NODE_ENV=production
PORT=4000
# Optional — per-site read tokens ("site:token" pairs) and event retention.
# SITE_READ_TOKENS=demo-store:example-token
# EVENT_RETENTION_DAYS=90
